# Mosaic environment (all local, no cloud keys required)
# Copy to .env and adjust. Never commit .env.

# Observer identity for captured observations (demo)
MOSAIC_OBSERVER=Field User 01

# Auto-save observations without confirmation (0/1)
MOSAIC_AUTOSAVE=0

# Dashboard port
PORT=4173

# Optional: force CPU inference instead of Vulkan GPU (0/1)
# QVAC_CPU_ONLY=0

# Model for extraction: unset = Qwen3-4B (~2.5GB); "small" = Qwen3-0.6B (~382MB)
# MOSAIC_EXTRACT_MODEL=small

# Optional: override on-device storage locations (defaults: ./data, ./evidence)
# MOSAIC_DATA_DIR=
# MOSAIC_EVIDENCE_DIR=
# MOSAIC_SEED_PATH=

# Optional: check GitHub Releases for updates on startup (default: manual via Help menu)
# MOSAIC_AUTO_UPDATE=0

# Optional: userData override (E2E tests / portable mode)
# MOSAIC_USER_DATA_DIR=

# Optional: QVAC config file and worker handshake timeout (ms)
# QVAC_CONFIG_PATH=qvac.config.json
# QVAC_RPC_INIT_TIMEOUT_MS=180000

# Optional: delegate inference to a peer's QVAC GPU server (OpenAI-compatible).
# URL must end in /v1; model default is mosaic-llm; key is the peer's bearer key.
# MOSAIC_LLM_URL=http://<peer-ip>:11437/v1
# MOSAIC_LLM_MODEL=mosaic-llm
# MOSAIC_LLM_API_KEY=change-me