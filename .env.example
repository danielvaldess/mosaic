# FieldSight environment (all local, no cloud keys required)
# Copy to .env and adjust. Never commit .env.

# Observer identity for captured observations (demo)
FIELDSIGHT_OBSERVER=Field User 01

# Auto-save observations without confirmation (0/1)
FIELDSIGHT_AUTOSAVE=0

# Dashboard port
PORT=4173

# Optional: force CPU inference instead of Vulkan GPU (0/1)
# QVAC_CPU_ONLY=0