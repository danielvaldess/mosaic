# FieldSight environment (all local, no cloud keys required)
# Copy to .env and adjust. Never commit .env.

# Observer identity for captured observations (demo)
FIELDSIGHT_OBSERVER=Field User 01

# Auto-save observations without confirmation (0/1)
FIELDSIGHT_AUTOSAVE=0

# Dashboard port
PORT=4173

# Optional: force CPU inference instead of Vulkan GPU (0/1)
# QVAC_CPU_ONLY=0

# Model for extraction: unset = Qwen3-4B (~2.5GB); "small" = Qwen3-0.6B (~382MB)
# FIELDSIGHT_EXTRACT_MODEL=small

# Optional: override on-device storage locations (defaults: ./data, ./evidence)
# FIELDSIGHT_DATA_DIR=
# FIELDSIGHT_EVIDENCE_DIR=
# FIELDSIGHT_SEED_PATH=

# Optional: QVAC config file and worker handshake timeout (ms)
# QVAC_CONFIG_PATH=qvac.config.json
# QVAC_RPC_INIT_TIMEOUT_MS=180000

# Optional: delegate inference to a peer's QVAC GPU server (OpenAI-compatible).
# URL must end in /v1; model default is fieldsight-llm; key is the peer's bearer key.
# FIELDSIGHT_LLM_URL=http://<peer-ip>:11437/v1
# FIELDSIGHT_LLM_MODEL=fieldsight-llm
# FIELDSIGHT_LLM_API_KEY=change-me